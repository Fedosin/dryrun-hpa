      "title": "Goroutines and GC",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "go_goroutines{job=~\"$job\"}",
          "legendFormat": "goroutines {{pod}}",
          "refId": "A"
        },
        {
          "expr": "rate(go_gc_duration_seconds_count{job=~\"$job\"}[$__rate_interval])",
