        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Cached objects",
      "description": "Objects in the informer caches; pods dominate memory.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
