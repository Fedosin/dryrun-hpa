      "targets": [
        {
          "expr": "dryrun_hpa_informer_objects{job=~\"$job\"}",
          "legendFormat": "{{resource}}",
          "refId": "A"
        },
        {
          "expr": "dryrun_hpa_virtual_workloads{job=~\"$job\"}",
          "legendFormat": "virtual workloads",
          "refId": "B"
        },
        {
          "expr": "dryrun_hpa_virtual_pods{job=~\"$job\"}",
          "legendFormat": "virtual pods",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
