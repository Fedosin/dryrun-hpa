        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Cost per object",
      "description": "CPU millicores and MiB of memory per DryrunHPA.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "1000 * sum(rate(process_cpu_seconds_total{job=~\"$job\"}[$__rate_interval])) / sum(horizontal_pod_autoscaler_controller_num_horizontal_pod_autoscalers{job=~\"$job\"})",
          "legendFormat": "millicores",
          "refId": "A"
        },
        {
          "expr": "sum(process_resident_memory_bytes{job=~\"$job\"}) / 1048576 / sum(horizontal_pod_autoscaler_controller_num_horizontal_pod_autoscalers{job=~\"$job\"})",
          "legendFormat": "MiB",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
